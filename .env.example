# --- Apple merchant config -------------------------------------------------
APPLE_MERCHANT_ID=merchant.0xbuooy.testing
APPLE_DISPLAY_NAME=Iframe Harness Test

# The Apple-VERIFIED domain. This is the iframe's origin, and the value sent as
# `initiativeContext` during merchant validation. It is NOT the parent's domain.
PAYMENT_DOMAIN=pay.buooy.com

# --- Merchant Identity Certificate ------------------------------------------
# NOT the Payment Processing cert. Merchant validation uses the Merchant
# Identity cert for mTLS against Apple's gateway.
#
# Local dev: leave these blank, drop PEMs at certs/merchant_id_{cert,key}.pem
# Railway:   set both to base64 of the PEM files (see README "Deploy").
MERCHANT_ID_CERT_B64=
MERCHANT_ID_KEY_B64=

# --- Storefront ---------------------------------------------------------------
COUNTRY_CODE=SG
CURRENCY_CODE=SGD
TOTAL_LABEL=Iframe Harness
TOTAL_AMOUNT=1.00

# --- Server ------------------------------------------------------------------
PORT=3000
